# Writes stay inside this directory. Defaults to ./data.
CONTEXT_BRIDGE_DATA_DIR=./data

# Optional comma-separated list. Defaults to cwd, data dir, ~/Downloads, and ~/Documents.
CONTEXT_BRIDGE_IMPORT_ROOTS=

# stdio for local Codex/Claude-style clients, http for ChatGPT Apps SDK development.
CONTEXT_BRIDGE_TRANSPORT=stdio
PORT=3333

# Optional bearer token for HTTP mode. Leave unset for localhost-only development.
CONTEXT_BRIDGE_HTTP_TOKEN=
